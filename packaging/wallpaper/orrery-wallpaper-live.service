[Unit]
Description=Orrery: animated solar system background (Wayland layer-shell)
Documentation=https://github.com/fqazzazee/orrery
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=@BIN@ live
Restart=on-failure
RestartSec=10
# 3: this desktop has no layer-shell (GNOME, X11). Trying again will not help.
RestartPreventExitStatus=3

[Install]
WantedBy=graphical-session.target
